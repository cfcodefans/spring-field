type GraphEntity {
  id: ID!
  """Entity classification (e.g. node, edge, person, document)."""
  entityType: String!
  name: String!
  parentId: ID
  data: String
  note: String
  tags: [String!]!
  createdAt: String!
  updatedAt: String!
}

"""Optional filters are combined with AND. Omit the whole input or leave fields unset to skip that constraint."""
input GraphEntityFilterInput {
  """Exact match on entity_type."""
  entityType: String
  """Match rows with this parent id."""
  parentId: ID
  """
  When true, only rows with no parent (root entities).
  Ignored when parentId is set (parentId wins).
  """
  rootOnly: Boolean
  """Case-insensitive substring match on name."""
  nameContains: String
}

input CreateGraphEntityInput {
  entityType: String!
  name: String!
  parentId: ID
  data: String
  note: String
  tags: [String!]
}

input UpdateGraphEntityInput {
  id: ID!
  entityType: String
  name: String
  parentId: ID
  data: String
  note: String
  tags: [String!]
}

type Query {
  """List entities; pass filter to narrow results instead of many separate query fields."""
  entities(filter: GraphEntityFilterInput): [GraphEntity!]!
  entity(id: ID!): GraphEntity
}

type Mutation {
  createEntity(input: CreateGraphEntityInput!): GraphEntity!
  updateEntity(input: UpdateGraphEntityInput!): GraphEntity!
  deleteEntity(id: ID!): Boolean!
}
